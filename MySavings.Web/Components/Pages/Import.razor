@page "/import"
@using MySavings.Web.ApiClients
@inject ImportApiClient ImportApi
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Import Excel - MySavings</PageTitle>

<h1>Importer des données Excel</h1>

<div class="page-container">
    <div class="card">
        <h2>Sélectionner le fichier</h2>
        <p>Sélectionnez le fichier Excel contenant vos données MySavings.</p>

        <div class="upload-section">
            <InputFile OnChange="HandleFileSelected" accept=".xlsx,.xls" class="file-input" />

            @if (selectedFileName != null)
            {
                <div class="file-info">
                    <span class="file-name">@selectedFileName</span>
                    <span class="file-size">@fileSize</span>
                </div>
            }

            <button class="btn btn-primary" @onclick="UploadFile" disabled="@(selectedFile == null || isUploading)">
                @if (isUploading)
                {
                    <span>Import en cours...</span>
                }
                else
                {
                    <span>Importer</span>
                }
            </button>
        </div>

        @if (!string.IsNullOrEmpty(resultMessage))
        {
            <div class="@(importSuccess ? "alert alert-success" : "alert alert-error")">
                @resultMessage
            </div>
        }
    </div>

    <div class="card info-section">
        <h3>Format attendu</h3>
        <p>
            <strong>Note&nbsp;:</strong> Le système lit automatiquement la <strong>première feuille</strong> du fichier,
            quel que soit son nom. La détection des colonnes est flexible — l'ordre n'a pas d'importance.
        </p>
        <p class="text-warning">
            <strong>Important&nbsp;:</strong> les propriétaires des comptes doivent être correctement renseignés
            dans les en-têtes de comptes avant l'import (nom du propriétaire en dernier mot du nom du compte).
        </p>
        <p class="text-muted">
            Les <strong>groupements de virements</strong> ne sont pas importés depuis Excel&nbsp;: ils restent gérés uniquement dans l'application.
        </p>

        <h4>Structure de la feuille <small class="text-muted">(inspirée de <em>Epargne Consolidée.xlsx</em>)</small></h4>
        <p>La ligne&nbsp;1 contient les en-têtes. Chaque ligne suivante correspond à un mois.</p>

        <div class="excel-preview">
            <table class="format-table excel-table">
                <thead>
                    <tr class="header-row">
                        <th>Date</th>
                        <th>Salaire Louis</th>
                        <th>Salaire Alice</th>
                        <th>Total Salaire</th>
                        <th>Dépenses</th>
                        <th>Epargne</th>
                        <th>E/S Ratio</th>
                        <th>PEA Louis</th>
                        <th>LDD Alice</th>
                        <th>% Louis M-1</th>
                        <th>% Alice M-1</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>01/01/2024</td>
                        <td>3&nbsp;500</td>
                        <td>2&nbsp;800</td>
                        <td>6&nbsp;300</td>
                        <td>4&nbsp;500</td>
                        <td>1&nbsp;800</td>
                        <td>28,6&nbsp;%</td>
                        <td>600</td>
                        <td>450</td>
                        <td>55,6&nbsp;%</td>
                        <td>44,4&nbsp;%</td>
                    </tr>
                    <tr>
                        <td>01/02/2024</td>
                        <td>3&nbsp;500</td>
                        <td>2&nbsp;800</td>
                        <td>6&nbsp;300</td>
                        <td>4&nbsp;200</td>
                        <td>2&nbsp;100</td>
                        <td>33,3&nbsp;%</td>
                        <td>700</td>
                        <td>530</td>
                        <td>55,6&nbsp;%</td>
                        <td>44,4&nbsp;%</td>
                    </tr>
                    <tr>
                        <td class="text-muted text-center" colspan="11">…</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="format-legend mt-3">
            <h4>Légende des colonnes</h4>
            <table class="format-table">
                <thead>
                    <tr>
                        <th>Colonne</th>
                        <th>En-tête acceptée</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>Date</strong></td>
                        <td><code>Date</code></td>
                        <td>Premier jour du mois (format date Excel ou texte)</td>
                    </tr>
                    <tr>
                        <td><strong>Salaire pers.&nbsp;1</strong></td>
                        <td><code>Salaire L</code>, <code>Salaire Louis</code>, <code>Person1</code></td>
                        <td>Revenu mensuel de la première personne</td>
                    </tr>
                    <tr>
                        <td><strong>Salaire pers.&nbsp;2</strong></td>
                        <td><code>Salaire A</code>, <code>Salaire Alice</code>, <code>Person2</code></td>
                        <td>Revenu mensuel de la deuxième personne</td>
                    </tr>
                    <tr>
                        <td><strong>Dépenses</strong></td>
                        <td><code>Dépenses</code>, <code>Expenses</code></td>
                        <td>Total des dépenses communes du couple</td>
                    </tr>
                    <tr>
                        <td><strong>Comptes d'épargne</strong></td>
                        <td><em>Nom libre</em> (ex.&nbsp;<code>PEA Louis</code>, <code>LDD Alice</code>)</td>
                        <td>Montant alloué. Le propriétaire est détecté dans le nom de la colonne.</td>
                    </tr>
                    <tr>
                        <td><strong>% M-1</strong></td>
                        <td><code>% Louis M-1</code>, <code>% Alice M-1</code></td>
                        <td>Part de contribution du mois précédent (utilisée pour le calcul d'allocation)</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private IBrowserFile? selectedFile;
    private string? selectedFileName;
    private string? fileSize;
    private string? resultMessage;
    private bool importSuccess;
    private bool isUploading;

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        selectedFileName = e.File.Name;

        long bytes = e.File.Size;
        if (bytes < 1024)
            fileSize = $"{bytes} B";
        else if (bytes < 1024 * 1024)
            fileSize = $"{bytes / 1024:N2} KB";
        else
            fileSize = $"{bytes / (1024 * 1024):N2} MB";

        resultMessage = null;
        StateHasChanged();
    }

    private async Task UploadFile()
    {
        if (selectedFile == null) return;

        isUploading = true;
        resultMessage = null;

        try
        {
            var fileStream = selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var result = await ImportApi.ImportExcelAsync(fileStream, selectedFile.Name);

            if (result != null && result.Success)
            {
                importSuccess = true;
                resultMessage = result.Message;

                selectedFile = null;
                selectedFileName = null;
                fileSize = null;

                await Task.Delay(2000);
                Navigation.NavigateTo("/savings", forceLoad: true);
            }
            else
            {
                importSuccess = false;
                resultMessage = result?.Message ?? "Unknown error during import";
            }
        }
        catch (Exception ex)
        {
            importSuccess = false;
            resultMessage = $"Error during import: {ex.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }
}
