@page "/settings"
@using MySavings.Web.ApiClients
@inject PersonSettingsApiClient PersonSettingsApi
@inject AppSettingsApiClient AppSettingsApi
@inject ImportApiClient ImportApi
@inject DatabaseApiClient DatabaseApi
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Paramètres - MySavings</PageTitle>

<h1>Paramètres</h1>

<div class="page-container">
    @if (isLoading)
    {
        <p><em>Chargement...</em></p>
    }
    else
    {
        <div class="card">
            <h2>Noms des personnes</h2>
            <p>Configurez les noms d'affichage. Ils seront utilisés dans toute l'interface.</p>

            @for (var i = 0; i < personSettings.Count; i++)
            {
                var settings = personSettings[i];
                <div class="form-group">
                    <label>
                        @(i == 0
                            ? "Nom d'affichage de la première personne"
                            : "Nom d'affichage de la deuxième personne")
                    </label>
                    <div class="input-with-button">
                        <input type="text" @bind="settings.Name" class="form-control" />
                        <button class="btn btn-primary" @onclick="@(() => SaveSettings(settings))" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span>Enregistrement...</span>
                            }
                            else
                            {
                                <span>Enregistrer</span>
                            }
                        </button>
                    </div>
                    <small class="text-muted">@(settings.LastModified == DateTime.MinValue ? "Jamais enregistré" : $"Dernière modification: {settings.LastModified.ToString("dd/MM/yyyy HH:mm")}")</small>
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success">
                    @successMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-error">
                    @errorMessage
                </div>
            }
        </div>

        <div class="card">
            <h2>Solde de sécurité</h2>
            <p>Montant conservé sur vos comptes courants, non compté comme épargne, utilisé pour calculer les dépenses du mois à partir du solde de fin de mois.</p>

            <div class="form-group">
                <label>Solde de sécurité (€)</label>
                <div class="input-with-button">
                    <input type="number" step="0.01" min="0" @bind="securityBuffer" class="form-control" />
                    <button class="btn btn-primary" @onclick="SaveSecurityBuffer" disabled="@isSavingBuffer">
                        @(isSavingBuffer ? "Enregistrement..." : "Enregistrer")
                    </button>
                </div>
                <small class="text-muted">S'applique aux prochaines saisies ou modifications de mois ; n'affecte pas rétroactivement les mois déjà enregistrés.</small>
            </div>

            @if (!string.IsNullOrEmpty(bufferSuccessMessage))
            {
                <div class="alert alert-success">@bufferSuccessMessage</div>
            }
            @if (!string.IsNullOrEmpty(bufferErrorMessage))
            {
                <div class="alert alert-error">@bufferErrorMessage</div>
            }
        </div>

        <div class="card">
            <h2>Import / Export Excel</h2>
            <p>Accédez à l'import et exportez un fichier Excel au format attendu par l'application.</p>
            <div class="action-row">
                <a href="/import" class="btn btn-primary">Importer un fichier Excel</a>
                <button class="btn btn-primary" @onclick="ExportExcelAsync" disabled="@isExporting">
                    @(isExporting ? "Export en cours..." : "Exporter en Excel")
                </button>
            </div>
        </div>

        <div class="card">
            <h2>Maintenance</h2>
            <p>Actions sensibles de maintenance des données.</p>
            <div class="action-row">
                <button class="btn btn-danger" @onclick="ClearDatabaseAsync" disabled="@isClearing">
                    @(isClearing ? "Suppression..." : "Vider la base")
                </button>
            </div>
        </div>
    }
</div>

@code {
    private List<PersonSettingsDto> personSettings = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private bool isExporting = false;
    private bool isClearing = false;
    private string? successMessage;
    private string? errorMessage;

    private decimal securityBuffer;
    private bool isSavingBuffer = false;
    private string? bufferSuccessMessage;
    private string? bufferErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadSettings();
    }

    private async Task LoadSettings()
    {
        isLoading = true;
        try
        {
            personSettings = (await PersonSettingsApi.GetAllAsync())
                .OrderBy(s => s.Id)
                .ToList();

            securityBuffer = (await AppSettingsApi.GetAsync()).SecurityBuffer;
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur lors du chargement des paramètres: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveSettings(PersonSettingsDto settings)
    {
        isSaving = true;
        successMessage = null;
        errorMessage = null;

        try
        {
            var request = new UpdatePersonSettingsRequest { Name = settings.Name };
            var result = await PersonSettingsApi.UpdateAsync(settings.Id, request);

            if (result != null)
            {               
                successMessage = $"Le nom a été enregistré avec succès!";
                await LoadSettings();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur lors de l'enregistrement: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SaveSecurityBuffer()
    {
        isSavingBuffer = true;
        bufferSuccessMessage = null;
        bufferErrorMessage = null;

        try
        {
            var response = await AppSettingsApi.UpdateAsync(new UpdateAppSettingsRequest { SecurityBuffer = securityBuffer });
            if (response.IsSuccessStatusCode)
            {
                bufferSuccessMessage = "Solde de sécurité enregistré avec succès ! Ce changement s'appliquera à partir de la prochaine saisie ou modification de mois ; les mois déjà enregistrés ne sont pas modifiés.";
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                bufferErrorMessage = $"Erreur : {body}";
            }
        }
        catch (Exception ex)
        {
            bufferErrorMessage = $"Erreur lors de l'enregistrement: {ex.Message}";
        }
        finally
        {
            isSavingBuffer = false;
        }
    }

    private async Task ExportExcelAsync()
    {
        isExporting = true;
        successMessage = null;
        errorMessage = null;

        try
        {
            var export = await ImportApi.ExportExcelAsync();
            if (export == null)
            {
                errorMessage = "Erreur lors de l'export Excel.";
                return;
            }

            var base64 = Convert.ToBase64String(export.Value.Content);
            await JS.InvokeVoidAsync("downloadFileFromBase64", export.Value.FileName, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", base64);
            successMessage = "Export Excel généré avec succès.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur lors de l'export: {ex.Message}";
        }
        finally
        {
            isExporting = false;
        }
    }

    private async Task ClearDatabaseAsync()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Confirmer la suppression complète de la base ?");
        if (!confirmed)
        {
            return;
        }

        isClearing = true;
        successMessage = null;
        errorMessage = null;

        try
        {
            var response = await DatabaseApi.ClearDatabaseAsync();
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = $"Erreur ({(int)response.StatusCode}) lors de la suppression de la base.";
                return;
            }

            successMessage = "Base vidée avec succès.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur lors de la suppression: {ex.Message}";
        }
        finally
        {
            isClearing = false;
        }
    }
}
